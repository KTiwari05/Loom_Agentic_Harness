# Copy this file to `.env` and fill in ONE provider.  LiteLLM picks the provider
# from the model prefix in LOOM_MODEL, so the model string and the key must match.
#
# Desktop app users: you can skip this file entirely — the Customize screen in
# `loom ui` saves the same settings to ~/.loom/loom.env (works for the CLI too;
# a local .env still wins if both exist).

# ─── Option A: OpenRouter (recommended to start — one key, every open model) ───
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model string format: openrouter/<vendor>/<model>
LOOM_MODEL=openrouter/moonshotai/kimi-k2

# ─── Option B: Moonshot direct (best Kimi pricing once you optimize) ───
# MOONSHOT_API_KEY=
# LOOM_MODEL=moonshot/kimi-k2-0711-preview

# ─── Routing tiers (all optional — default to LOOM_MODEL) ───
# Strong model used after a failed step or critic rejection:
# LOOM_MODEL_STRONG=openrouter/deepseek/deepseek-v4
# Reviewer model used by the Critic:
# LOOM_MODEL_CRITIC=openrouter/z-ai/glm-5.1

# ─── Behaviour ───
LOOM_TEMPERATURE=0.2
LOOM_MAX_STEPS=30
LOOM_MAX_COST_USD=1.0
# Set to 1 to skip permission prompts (use only in trusted/throwaway dirs)
LOOM_AUTO_APPROVE=0
# The Critic reviews every diff before "done" (1 = on)
LOOM_CRITIC=1
LOOM_MAX_CRITIC_ROUNDS=2
# Frontier reference pricing for the "$ saved" meter (USD per 1M tokens)
LOOM_BASELINE_INPUT_PER_M=3.0
LOOM_BASELINE_OUTPUT_PER_M=15.0
